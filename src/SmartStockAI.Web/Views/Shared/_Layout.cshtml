<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SmartStock AI</title>
    <link rel="icon" type="image/svg+xml" href="~/img/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var esAdmin = User.IsInRole(AppRoles.Administrador);
    var esVendedor = User.IsInRole(AppRoles.Vendedor);
    var esInventario = User.IsInRole(AppRoles.Inventario);
    var verInventario = esAdmin || esInventario;   // categorías, inventario, compras, proveedores, reportes, IA
    var verVentas = esAdmin || esVendedor;
    var rol = AppRoles.Todos.FirstOrDefault(User.IsInRole) ?? "";

    <div class="ss-app">
        <aside class="ss-sidebar">
            <div class="ss-sidebar-logo">
                <img src="~/img/logo.svg" class="ss-logo-hex" style="width:34px;height:34px;" alt="SmartStock" />
                <div>
                    <div style="font-weight:700;color:var(--ss-dark);line-height:1;">SmartStock</div>
                    <div style="font-size:.65rem;color:var(--ss-text-muted);">Gestión con precisión</div>
                </div>
            </div>
            <nav class="ss-sidebar-nav">
                <a class="ss-nav-link @(controlador=="Dashboard"?"active":"")" asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-gauge"></i> Dashboard</a>
                <a class="ss-nav-link @(controlador=="Productos"?"active":"")" asp-controller="Productos" asp-action="Index"><i class="fa-solid fa-box"></i> Productos</a>
                @if (verInventario)
                {
                    <a class="ss-nav-link @(controlador=="Categorias"?"active":"")" asp-controller="Categorias" asp-action="Index"><i class="fa-solid fa-tags"></i> Categorías</a>
                    <a class="ss-nav-link @(controlador=="Inventario"?"active":"")" asp-controller="Inventario" asp-action="Index"><i class="fa-solid fa-warehouse"></i> Inventario</a>
                }
                @if (verVentas)
                {
                    <a class="ss-nav-link @(controlador=="Ventas"?"active":"")" asp-controller="Ventas" asp-action="Index"><i class="fa-solid fa-cash-register"></i> Ventas</a>
                }
                @if (verInventario)
                {
                    <a class="ss-nav-link @(controlador=="Compras"?"active":"")" asp-controller="Compras" asp-action="Index"><i class="fa-solid fa-truck"></i> Compras</a>
                    <a class="ss-nav-link @(controlador=="Proveedores"?"active":"")" asp-controller="Proveedores" asp-action="Index"><i class="fa-solid fa-handshake"></i> Proveedores</a>
                    <a class="ss-nav-link @(controlador=="Reportes"?"active":"")" asp-controller="Reportes" asp-action="Index"><i class="fa-solid fa-chart-line"></i> Reportes</a>
                    <a class="ss-nav-link @(controlador=="Recomendaciones"?"active":"")" asp-controller="Recomendaciones" asp-action="Index"><i class="fa-solid fa-robot"></i> IA</a>
                }
                @if (esAdmin)
                {
                    <a class="ss-nav-link @(controlador=="Usuarios"?"active":"")" asp-controller="Usuarios" asp-action="Index"><i class="fa-solid fa-users"></i> Usuarios</a>
                }
            </nav>
            <div style="padding:.75rem;border-top:1px solid var(--ss-border);">
                <a class="ss-nav-link @(controlador=="Configuracion"?"active":"")" asp-controller="Configuracion" asp-action="Index"><i class="fa-solid fa-gear"></i> Configuración</a>
            </div>
        </aside>

        <div class="ss-main">
            <header class="ss-topbar">
                <span style="color:var(--ss-text-muted);font-size:.9rem;">@User.Identity?.Name</span>
                <span class="badge bg-secondary">@rol</span>
                <div class="ss-avatar">@(User.Identity?.Name?.Substring(0,1).ToUpper())</div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                    <button type="submit" class="btn btn-sm btn-ss-outline" title="Cerrar sesión"><i class="fa-solid fa-right-from-bracket"></i></button>
                </form>
            </header>
            <main class="ss-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
