@model ChangePasswordViewModel
@{ ViewData["Title"] = "Cambiar contraseña"; }
<h2 class="ss-title mb-4">Configuración de cuenta</h2>
<div class="ss-panel" style="max-width:480px;">
    <h5 class="ss-panel-title">Cambiar contraseña</h5>
    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-success">@ViewBag.Mensaje</div>
    }
    <form asp-controller="Account" asp-action="ChangePassword" method="post">
        <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>
        <div class="mb-3">
            <label asp-for="ContrasenaActual" class="form-label"></label>
            <input asp-for="ContrasenaActual" type="password" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="NuevaContrasena" class="form-label"></label>
            <input asp-for="NuevaContrasena" type="password" class="form-control" />
            <span asp-validation-for="NuevaContrasena" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmarContrasena" class="form-label"></label>
            <input asp-for="ConfirmarContrasena" type="password" class="form-control" />
            <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-ss-primary">Actualizar contraseña</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
