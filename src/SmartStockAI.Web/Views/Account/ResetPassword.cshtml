@model ResetPasswordViewModel
@{ ViewData["Title"] = "Restablecer contraseña"; Layout = null; }
<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Restablecer contraseña - SmartStock AI</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body>
<div class="ss-auth-wrapper">
  <div class="ss-auth-form">
    <div class="ss-auth-card">
      <h1 class="ss-title mb-4">Restablecer contraseña</h1>
      <form asp-controller="Account" asp-action="ResetPassword" method="post">
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />
        <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>
        <div class="mb-3">
          <label asp-for="Contrasena" class="form-label"></label>
          <input asp-for="Contrasena" type="password" class="form-control" autofocus/>
          <span asp-validation-for="Contrasena" class="text-danger small"></span>
        </div>
        <div class="mb-3">
          <label asp-for="ConfirmarContrasena" class="form-label"></label>
          <input asp-for="ConfirmarContrasena" type="password" class="form-control"/>
          <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-ss-primary w-100 py-2">Guardar nueva contraseña</button>
      </form>
    </div>
  </div>
  <div class="ss-auth-brand">
    <img src="~/img/logo.svg" class="ss-logo-hex" alt="SmartStock AI" />
    <h1>SmartStock</h1><p>Gestión de inventarios con precisión</p>
  </div>
</div>
<partial name="_ValidationScriptsPartial" />
</body></html>
