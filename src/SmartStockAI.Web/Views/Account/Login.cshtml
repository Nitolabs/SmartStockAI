@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar sesión - SmartStock AI</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="ss-auth-wrapper">
    <div class="ss-auth-form">
        <div class="ss-auth-card">
            <h1 class="ss-title mb-4">Bienvenido Administrador</h1>

            <form asp-controller="Account" asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <div class="mb-3">
                    <label asp-for="Usuario" class="form-label">Usuario:</label>
                    <input asp-for="Usuario" class="form-control ss-search-input" placeholder="Ingresa tu usuario" autofocus />
                    <span asp-validation-for="Usuario" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Contrasena" class="form-label">Contraseña:</label>
                    <input asp-for="Contrasena" type="password" class="form-control ss-search-input" placeholder="Ingresa tu contraseña" />
                    <span asp-validation-for="Contrasena" class="text-danger small"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="RecordarSesion" class="form-check-input" />
                    <label asp-for="RecordarSesion" class="form-check-label small">Recordar sesión</label>
                </div>

                <button type="submit" class="btn btn-ss-primary w-100 py-2">Ingresar</button>

                <div class="d-flex justify-content-between mt-3 small">
                    <a asp-action="ForgotPassword">¿Olvidaste tu contraseña?</a>
                    <a asp-action="Register">Crear cuenta de negocio</a>
                </div>
            </form>
        </div>
    </div>
    <div class="ss-auth-brand">
        <img src="~/img/logo.svg" class="ss-logo-hex" alt="SmartStock AI" />
        <h1>SmartStock</h1>
        <p>Gestión de inventarios con precisión</p>
    </div>
</div>
<partial name="_ValidationScriptsPartial" />
</body>
</html>
