@{
    ViewData["Title"] = "Solicitud enviada";
    Layout = null;
    var enlace = TempData["EnlaceRecuperacion"] as string;
}
<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Solicitud enviada - SmartStock AI</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body>
<div class="ss-auth-wrapper">
  <div class="ss-auth-form">
    <div class="ss-auth-card text-center">
      <i class="fa-solid fa-envelope-circle-check" style="font-size:3rem;color:var(--ss-teal);"></i>
      <h1 class="ss-title mt-3">Revisa tu correo</h1>
      <p class="text-muted">Si el correo existe en nuestro sistema, te enviamos un enlace para restablecer tu contraseña.</p>

      @if (!string.IsNullOrEmpty(enlace))
      {
          <div class="alert alert-warning text-start small">
              <strong>Modo demostración:</strong> el envío de correo no está activo, así que el enlace se muestra aquí.
              <div class="mt-2"><a href="@enlace">Restablecer mi contraseña</a></div>
          </div>
      }

      <a asp-controller="Account" asp-action="Login" class="btn btn-ss-primary mt-2">Volver a iniciar sesión</a>
    </div>
  </div>
  <div class="ss-auth-brand">
    <img src="~/img/logo.svg" class="ss-logo-hex" alt="SmartStock AI" />
    <h1>SmartStock</h1><p>Gestión de inventarios con precisión</p>
  </div>
</div>
</body></html>
