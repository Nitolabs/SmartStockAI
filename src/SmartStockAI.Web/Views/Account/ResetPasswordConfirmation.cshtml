@{ ViewData["Title"] = "Contraseña actualizada"; Layout = null; }
<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Contraseña actualizada - SmartStock AI</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body>
<div class="ss-auth-wrapper">
  <div class="ss-auth-form">
    <div class="ss-auth-card text-center">
      <i class="fa-solid fa-circle-check" style="font-size:3rem;color:var(--ss-teal);"></i>
      <h1 class="ss-title mt-3">Contraseña actualizada</h1>
      <p class="text-muted">Ya puedes iniciar sesión con tu nueva contraseña.</p>
      <a asp-controller="Account" asp-action="Login" class="btn btn-ss-primary mt-2">Iniciar sesión</a>
    </div>
  </div>
  <div class="ss-auth-brand">
    <img src="~/img/logo.svg" class="ss-logo-hex" alt="SmartStock AI" />
    <h1>SmartStock</h1><p>Gestión de inventarios con precisión</p>
  </div>
</div>
</body></html>
