@model RegisterViewModel
@{
    ViewData["Title"] = "Crear cuenta";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Crear cuenta - SmartStock AI</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="ss-auth-wrapper">
    <div class="ss-auth-form">
        <div class="ss-auth-card" style="max-width:440px;">
            <h1 class="ss-title mb-1">Crea tu negocio</h1>
            <p class="text-muted mb-4">Registra tu MYPE en SmartStock AI.</p>

            <form asp-controller="Account" asp-action="Register" method="post">
                <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <div class="row">
                    <div class="col-md-8 mb-3">
                        <label asp-for="NombreNegocio" class="form-label"></label>
                        <input asp-for="NombreNegocio" class="form-control" placeholder="Ej. Minisúper González" />
                        <span asp-validation-for="NombreNegocio" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Rubro" class="form-label"></label>
                        <input asp-for="Rubro" class="form-control" placeholder="Ej. Ferretería" />
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="NombreCompleto" class="form-label"></label>
                    <input asp-for="NombreCompleto" class="form-control" placeholder="Tu nombre completo" />
                    <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="correo@negocio.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Contrasena" class="form-label"></label>
                        <input asp-for="Contrasena" type="password" class="form-control" />
                        <span asp-validation-for="Contrasena" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ConfirmarContrasena" class="form-label"></label>
                        <input asp-for="ConfirmarContrasena" type="password" class="form-control" />
                        <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-ss-primary w-100 py-2 mt-2">Crear cuenta</button>
                <div class="text-center mt-3 small">
                    <a asp-action="Login">Ya tengo una cuenta</a>
                </div>
            </form>
        </div>
    </div>
    <div class="ss-auth-brand">
        <img src="~/img/logo.svg" class="ss-logo-hex" alt="SmartStock AI" />
        <h1>SmartStock</h1>
        <p>Gestión de inventarios con precisión</p>
    </div>
</div>
<partial name="_ValidationScriptsPartial" />
</body>
</html>
