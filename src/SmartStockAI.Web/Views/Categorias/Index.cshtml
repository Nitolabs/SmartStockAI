@model IReadOnlyList<CategoriaDto>
@{ ViewData["Title"] = "Categorías"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="ss-title mb-0">Gestión de categorías</h2>
    <button class="btn btn-ss-primary" data-bs-toggle="modal" data-bs-target="#modalCrear"><i class="fa-solid fa-plus me-1"></i> Agregar</button>
</div>

<div class="ss-panel">
    <table class="table table-ss mb-0">
        <thead><tr><th>Nombre</th><th>Descripción</th><th>Productos</th><th>Estado</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Nombre</td>
                <td class="text-muted small">@c.Descripcion</td>
                <td>@c.TotalProductos</td>
                <td>
                    @if (c.Activo)
                    {<span class="badge badge-stock-ok">Activa</span>}
                    else
                    {<span class="badge badge-stock-bajo">Inactiva</span>}
                </td>
                <td class="text-end">
                    <button class="btn btn-sm btn-ss-outline" data-bs-toggle="modal" data-bs-target="#modalEditar@(c.Id)"><i class="fa-solid fa-pen"></i></button>
                    @if (c.Activo)
                    {
                        <form asp-action="Deactivate" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@c.Id" />
                            <button type="submit" class="btn btn-sm btn-ss-outline" onclick="return confirm('¿Desactivar esta categoría?');"><i class="fa-solid fa-trash"></i></button>
                        </form>
                    }
                </td>
            </tr>

            <div class="modal fade" id="modalEditar@(c.Id)" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-action="Edit" method="post">
                            <div class="modal-header"><h5 class="modal-title">Editar categoría</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                            <div class="modal-body">
                                <input type="hidden" name="Id" value="@c.Id" />
                                <div class="mb-3"><label class="form-label">Nombre</label><input class="form-control" name="Nombre" value="@c.Nombre" required /></div>
                                <div class="mb-3"><label class="form-label">Descripción</label><textarea class="form-control" name="Descripcion">@c.Descripcion</textarea></div>
                                <div class="form-check"><input type="checkbox" class="form-check-input" name="Activo" value="true" checked="@c.Activo" /><label class="form-check-label">Activa</label></div>
                            </div>
                            <div class="modal-footer"><button type="submit" class="btn btn-ss-primary">Guardar</button></div>
                        </form>
                    </div>
                </div>
            </div>
        }
        </tbody>
    </table>
</div>

<div class="modal fade" id="modalCrear" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header"><h5 class="modal-title">Nueva categoría</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label">Nombre</label><input class="form-control" name="Nombre" required /></div>
                    <div class="mb-3"><label class="form-label">Descripción</label><textarea class="form-control" name="Descripcion"></textarea></div>
                </div>
                <div class="modal-footer"><button type="submit" class="btn btn-ss-primary">Guardar</button></div>
            </form>
        </div>
    </div>
</div>
