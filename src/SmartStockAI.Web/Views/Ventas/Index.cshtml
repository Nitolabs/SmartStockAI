@model PagedResult<VentaDto>
@{ ViewData["Title"] = "Ventas"; }

<h2 class="ss-title mb-4">Gestor de Ventas</h2>

<form id="formAntiForgery">@Html.AntiForgeryToken()</form>

<div class="ss-panel mb-4">
    <table class="table table-ss mb-3">
        <thead><tr><th>Producto</th><th>Precio</th><th>Cantidad</th><th>Descuento</th><th>Subtotal</th><th></th></tr></thead>
        <tbody id="carritoBody">
            <tr id="filaVacia"><td colspan="6" class="text-center text-muted small py-3">Busca un producto para agregarlo a la venta.</td></tr>
        </tbody>
    </table>

    <div class="row g-2 align-items-end">
        <div class="col-md-6 position-relative">
            <label class="form-label small">Buscar producto</label>
            <input type="text" id="buscarProducto" class="form-control ss-search-input" placeholder="Nombre o SKU..." autocomplete="off" />
            <div id="resultadosProducto" class="list-group position-absolute w-100" style="z-index:1000;"></div>
        </div>
        <div class="col-md-3">
            <label class="form-label small">Método de pago</label>
            <select id="metodoPago" class="form-select">
                <option value="1">Efectivo</option>
                <option value="2">Tarjeta débito</option>
                <option value="3">Tarjeta crédito</option>
                <option value="4">Transferencia</option>
                <option value="5">Otro</option>
            </select>
        </div>
        <div class="col-md-3 text-end">
            <div class="small text-muted">Subtotal: <span id="lblSubtotal">$0.00</span></div>
            <div class="fs-5 fw-bold">Total a pagar: <span id="lblTotal">$0.00</span></div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <button type="button" id="btnLimpiar" class="btn btn-ss-outline">Limpiar</button>
        <button type="button" id="btnEfectuarPago" class="btn btn-ss-primary"><i class="fa-solid fa-cash-register me-1"></i> Efectuar pago</button>
    </div>
</div>

<div class="ss-panel">
    <div class="ss-panel-title">Ventas recientes</div>
    <table class="table table-ss mb-0">
        <thead><tr><th>Documento</th><th>Fecha</th><th>Usuario</th><th>Total</th><th>Estado</th><th></th></tr></thead>
        <tbody>
        @foreach (var v in Model.Items)
        {
            <tr>
                <td>@v.NumeroDocumento</td>
                <td class="small">@v.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td class="small">@v.UsuarioNombre</td>
                <td>$@v.Total.ToString("N2")</td>
                <td>
                    @if (v.Estado == EstadoDocumento.Completada)
                    {<span class="badge badge-stock-ok">Completada</span>}
                    else
                    {<span class="badge badge-stock-bajo">Anulada</span>}
                </td>
                <td class="text-end">
                    @if (v.Estado == EstadoDocumento.Completada)
                    {
                        <form asp-action="Anular" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@v.Id" />
                            <button type="submit" class="btn btn-sm btn-ss-outline" onclick="return confirm('¿Anular esta venta? Se restaurará el inventario.');">Anular</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a></li>
            }
        </ul>
    </nav>
}

@section Scripts {
<script>
let carrito = [];

const buscarInput = document.getElementById('buscarProducto');
const resultadosDiv = document.getElementById('resultadosProducto');

buscarInput.addEventListener('input', ssDebounce(async () => {
    const texto = buscarInput.value.trim();
    resultadosDiv.innerHTML = '';
    if (texto.length < 1) return;

    const response = await fetch('/Ventas/BuscarProductos?texto=' + encodeURIComponent(texto));
    const productos = await response.json();

    productos.forEach(p => {
        const item = document.createElement('button');
        item.type = 'button';
        item.className = 'list-group-item list-group-item-action';
        item.innerHTML = `<strong>${ssEscape(p.nombre)}</strong> <span class="text-muted small">(${ssEscape(p.sku)}) — Stock: ${p.stockActual} — ${ssFormatMoney(p.precioVenta)}</span>`;
        item.onclick = () => { agregarProducto(p); resultadosDiv.innerHTML = ''; buscarInput.value = ''; };
        resultadosDiv.appendChild(item);
    });
}, 300));

document.addEventListener('click', (e) => {
    if (!resultadosDiv.contains(e.target) && e.target !== buscarInput) resultadosDiv.innerHTML = '';
});

function agregarProducto(p) {
    const existente = carrito.find(x => x.productoId === p.id);
    if (existente) {
        existente.cantidad += 1;
    } else {
        carrito.push({ productoId: p.id, nombre: p.nombre, precioUnitario: p.precioVenta, cantidad: 1, descuento: 0, stockDisponible: p.stockActual });
    }
    renderCarrito();
}

function renderCarrito() {
    const body = document.getElementById('carritoBody');
    body.innerHTML = '';
    if (carrito.length === 0) {
        body.innerHTML = '<tr id="filaVacia"><td colspan="6" class="text-center text-muted small py-3">Busca un producto para agregarlo a la venta.</td></tr>';
    }
    carrito.forEach((item, idx) => {
        const subtotal = (item.cantidad * item.precioUnitario) - item.descuento;
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td>${ssEscape(item.nombre)}</td>
            <td>${ssFormatMoney(item.precioUnitario)}</td>
            <td style="width:110px;"><input type="number" min="1" max="${item.stockDisponible}" class="form-control form-control-sm" value="${item.cantidad}" onchange="cambiarCantidad(${idx}, this.value)" /></td>
            <td style="width:110px;"><input type="number" min="0" step="0.01" class="form-control form-control-sm" value="${item.descuento}" onchange="cambiarDescuento(${idx}, this.value)" /></td>
            <td>${ssFormatMoney(subtotal)}</td>
            <td><button class="btn btn-sm btn-ss-outline" onclick="quitarProducto(${idx})"><i class="fa-solid fa-xmark"></i></button></td>
        `;
        body.appendChild(tr);
    });
    actualizarTotales();
}

function cambiarCantidad(idx, valor) {
    const cantidad = Math.max(1, Math.min(parseInt(valor) || 1, carrito[idx].stockDisponible));
    carrito[idx].cantidad = cantidad;
    renderCarrito();
}
function cambiarDescuento(idx, valor) {
    carrito[idx].descuento = Math.max(0, parseFloat(valor) || 0);
    renderCarrito();
}
function quitarProducto(idx) {
    carrito.splice(idx, 1);
    renderCarrito();
}

function actualizarTotales() {
    const subtotal = carrito.reduce((acc, i) => acc + (i.cantidad * i.precioUnitario), 0);
    const descuentos = carrito.reduce((acc, i) => acc + i.descuento, 0);
    document.getElementById('lblSubtotal').textContent = ssFormatMoney(subtotal);
    document.getElementById('lblTotal').textContent = ssFormatMoney(subtotal - descuentos);
}

document.getElementById('btnLimpiar').onclick = () => { carrito = []; renderCarrito(); };

document.getElementById('btnEfectuarPago').onclick = async () => {
    if (carrito.length === 0) { alert('Agrega al menos un producto a la venta.'); return; }

    const dto = {
        metodoPago: parseInt(document.getElementById('metodoPago').value),
        descuento: carrito.reduce((acc, i) => acc + i.descuento, 0),
        detalles: carrito.map(i => ({ productoId: i.productoId, cantidad: i.cantidad, descuento: i.descuento }))
    };

    const { ok, data } = await ssPostJson('/Ventas/Registrar', dto);
    if (!ok) { alert(data.message || 'No se pudo registrar la venta.'); return; }

    alert('Venta registrada correctamente.');
    window.location.reload();
};
</script>
}
