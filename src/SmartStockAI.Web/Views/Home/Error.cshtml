@model string
@{ ViewData["Title"] = "Error"; Layout = "_Layout"; }
<div class="text-center py-5">
    <i class="fa-solid fa-triangle-exclamation" style="font-size:3rem;color:var(--ss-danger);"></i>
    <h2 class="mt-3">Ocurrió un error inesperado</h2>
    <p class="text-muted">Nuestro equipo ya fue notificado. Puedes volver al dashboard e intentarlo de nuevo.</p>
    <p class="text-muted small">ID de referencia: @Model</p>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-ss-primary mt-2">Volver al Dashboard</a>
</div>
