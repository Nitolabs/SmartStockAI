# Copia este archivo como ".env" y completa los valores.
# NUNCA subas el ".env" real al repositorio (ya está en .gitignore).

# ---------- Base de datos (contenedor SQL Server) ----------
# Mínimo 8 caracteres con mayúscula, minúscula, número y símbolo.
# Evita los caracteres ; = $ y comillas: rompen la cadena de conexión.
DB_SA_PASSWORD=

# ---------- Inteligencia Artificial ----------
# OpenAI  -> AI_PROVIDER=OpenAI       (AI_MODEL = nombre del modelo)
# Azure   -> AI_PROVIDER=AzureOpenAI  (AI_MODEL = nombre del deployment,
#            y completa AI_ENDPOINT y AI_API_VERSION según la doc de Azure)
# Si AI_API_KEY queda vacío, la app funciona solo con alertas por reglas.
AI_PROVIDER=OpenAI
AI_MODEL=
AI_API_KEY=
AI_ENDPOINT=
AI_API_VERSION=

# ---------- Recuperación de contraseña ----------
# Opción 1 (correo real): completa el servidor SMTP. Con Gmail usa una "contraseña de aplicación".
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_ENABLE_SSL=true
# Opción 2 (SOLO demostración, sin SMTP): muestra el enlace de recuperación en pantalla.
# Déjalo en false en cualquier uso real: permitiría restablecer la contraseña de una cuenta conociendo su correo.
AUTH_MOSTRAR_ENLACE_RECUPERACION=false
